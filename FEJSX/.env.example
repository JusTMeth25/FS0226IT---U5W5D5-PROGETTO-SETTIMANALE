# Copia in .env.local (ignorato da git) e inserisci i valori
VITE_API_URL=http://localhost:8080
# Chiave browser con Maps JavaScript API abilitata (restrizione referrer http://localhost:5173/*)
VITE_GOOGLE_MAPS_API_KEY=
# Map ID per AdvancedMarker; DEMO_MAP_ID va bene in sviluppo
VITE_GOOGLE_MAPS_MAP_ID=DEMO_MAP_ID
